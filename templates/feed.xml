{% if term -%}
  {% set section = get_section(path="_index.md", metadata_only=true) -%}
  {% set tag = get_taxonomy_term(kind=taxonomy.name, term=term.name) -%}
  {% set feed_path = tag.path -%}
  {% set feed_title = 'Posts tagged "' ~ tag.name ~ '" | ' ~ section.title -%}
  {% set posts = tag.pages -%}
{% else -%}
  {% set section_path = feed_url | trim_start(pat=config.base_url ~ "/") | trim_end(pat="feed.xml") -%}
  {% set section = get_section(path=section_path ~ "_index.md") -%}
  {% set feed_path = section.path -%}
  {% set feed_title = section.title -%}
  {% set posts = section.pages -%}
{% endif -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
    <generator uri="{{ config.base_url | safe }}{{ feed_path | safe }}" version="0.1.0">{{ feed_title }}</generator>
    <link href="{{ config.base_url | safe }}{{ feed_path | safe }}feed.xml" rel="self" type="application/atom+xml" />
    <link href="{{ config.base_url | safe }}{{ feed_path | safe }}" rel="alternate" type="text/html" />
    <id>{{ config.base_url | safe }}{{ feed_path | safe }}</id>
    <title>{{ feed_title }}</title>
    <subtitle>{{ section.description }}</subtitle>
    <author>
        <name>Maintained by {{ section.extra.maintained_by }}.</name>
        <uri>https://github.com/rust-lang/lang-research/</uri>
    </author>
    <updated>{{ now() | date(format="%Y-%m-%dT%H:%M:%S+00:00") }}</updated>

    {% for page in posts %}
    <entry>
        <title>{{<escape_hbs input={page.title} />}}</title>
        <link rel="alternate" href="{{ config.base_url | safe }}{{<escape_hbs input={page.path} />}}" type="text/html" title="{{<escape_hbs input={page.title} />}}" />
        <published>{{ page.date | date(format="%Y-%m-%dT%H:%M:%S+00:00") }}</published>
        <updated>{% if page.updated %}{{ page.updated | date(format="%Y-%m-%dT%H:%M:%S+00:00") }}{% else %}{{ page.date | date(format="%Y-%m-%dT%H:%M:%S+00:00") }}{% endif %}</updated>
        <id>{{ config.base_url | safe }}{{<escape_hbs input={page.path} />}}</id>
        <content type="html" xml:base="{{ config.base_url | safe }}{{<escape_hbs input={page.path} />}}">{{<escape_hbs input={page.content} />}}</content>

        <author>
            <name>{{<escape_hbs input={page.authors | join(sep=", ")} />}}</name>
        </author>
    </entry>
    {%- if loop.index == 10 %}{% break %}{% endif %}
    {%- endfor %}
</feed>
